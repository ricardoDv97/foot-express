---
import { products } from "../data/products";
import ProductCard from "./ProductCard.astro";
---

<section
  id="menu"
  class="py-28"
>

  <div class="container-custom">

    <div
      class="mx-auto mb-16 max-w-3xl text-center"
    >

      <span
        class="inline-flex rounded-full border border-[var(--color-primary)]/30 bg-[var(--color-primary)]/10 px-5 py-2 text-sm font-semibold text-[var(--color-primary)]"
      >
        🍕 Food Express
      </span>

      <h2
        class="section-title mt-6"
      >
        Nuestros Productos
      </h2>

      <p
        class="section-subtitle mt-6"
      >
        Descubrí algunos de los platos favoritos de nuestros clientes.
        Preparados con ingredientes frescos, mucho sabor y la mejor atención.
      </p>

    </div>

    <div
      class="grid gap-8 md:grid-cols-2 xl:grid-cols-4"
    >

      {
        products.map((product) => (
          <ProductCard product={product} />
        ))
      }

    </div>

  </div>

</section>