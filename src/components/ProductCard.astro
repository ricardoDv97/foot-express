---
const { product } = Astro.props;

const phone = "5490000000000";

const url = `https://wa.me/${phone}?text=${encodeURIComponent(product.whatsapp)}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="card group flex h-full flex-col overflow-hidden"
>

  <div class="overflow-hidden">

    <img
      src={product.image.src}
      alt={product.name}
      class="h-64 w-full object-cover transition duration-700 group-hover:scale-110"
    />

  </div>

  <div class="flex flex-1 flex-col p-6">

    <span
      class="mb-2 inline-flex w-fit rounded-full bg-[var(--color-primary)]/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-[var(--color-primary)]"
    >
      {product.category}
    </span>

    <h3
      class="text-2xl font-bold"
    >
      {product.name}
    </h3>

    <p
      class="mt-4 flex-1 leading-7 text-gray-400"
    >
      {product.description}
    </p>

    <div
      class="mt-8 flex items-center justify-between"
    >

      <span
        class="text-3xl font-bold text-[var(--color-primary)]"
      >
        {product.price}
      </span>

      <span
        class="btn-primary px-5 py-3 text-sm"
      >
        Pedir
      </span>

    </div>

  </div>

</a>