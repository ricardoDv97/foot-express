---
import pizza from "../assets/pizza-hero.png";
import { Image } from "astro:assets";
import { SITE } from "../config/site.js";
---

<section
  id="inicio"
  data-hero
  class="relative overflow-hidden bg-[var(--color-dark)]"
>

  <!-- Fondo -->
  <div class="absolute inset-0">
    <div class="absolute -left-40 -top-40 h-96 w-96 rounded-full bg-yellow-500/10 blur-3xl"></div>
    <div class="absolute -right-40 bottom-0 h-[30rem] w-[30rem] rounded-full bg-red-700/10 blur-3xl"></div>
  </div>

  <div class="container-custom relative grid min-h-[90vh] items-center gap-16 py-20 lg:grid-cols-2">

    <!-- Texto -->

    <div>

      <span class="inline-flex rounded-full border border-yellow-500/30 bg-yellow-500/10 px-5 py-2 text-sm font-semibold text-[var(--color-primary)]">
        🔥 Desde 2026 • Miguel Lanús
      </span>

      <h1 class="section-title mt-8">

        La mejor

        <span class="text-[var(--color-primary)]">

          comida rápida

        </span>

        de Posadas

      </h1>

      <p class="section-subtitle mt-8 max-w-xl">

        Disfrutá pizzas, hamburguesas,
        sandwiches de milanesa, papas fritas
        y mucho más. Preparado en el momento
        con ingredientes frescos.

      </p>

      <div class="mt-10 flex flex-wrap gap-5">

        <a
          href="#menu"
          class="btn-primary"
        >
          Ver menú
        </a>

        <a
          href={SITE.whatsappUrl}
          class="btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Pedir por WhatsApp
        </a>

      </div>

      <!-- Beneficios -->

      <div class="mt-16 grid gap-5 sm:grid-cols-3">

        <div class="card p-5 text-center">

          <div class="text-4xl">
            🚚
          </div>

          <h3 class="mt-3 font-bold">
            Delivery
          </h3>

          <p class="mt-2 text-sm text-gray-400">
            Entrega rápida
          </p>

        </div>

        <div class="card p-5 text-center">

          <div class="text-4xl">
            🍕
          </div>

          <h3 class="mt-3 font-bold">
            Frescura
          </h3>

          <p class="mt-2 text-sm text-gray-400">
            Ingredientes frescos
          </p>

        </div>

        <div class="card p-5 text-center">

          <div class="text-4xl">
            ⭐
          </div>

          <h3 class="mt-3 font-bold">
            Calidad
          </h3>

          <p class="mt-2 text-sm text-gray-400">
            Garantizada
          </p>

        </div>

      </div>

    </div>

    <!-- Imagen -->

    <div class="relative flex justify-center">

      <div class="absolute h-[450px] w-[450px] rounded-full bg-yellow-500/15 blur-3xl"></div>

      <div data-hero-pizza-motion class="relative z-10 w-full max-w-xl will-change-transform">
        <Image
          src={pizza}
          alt="Pizza"
          width={960}
          format="webp"
          quality={75}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="floating w-full drop-shadow-[0_35px_45px_rgba(0,0,0,.7)]"
        />
      </div>

    </div>

  </div>

</section>

<script>
  const hero = document.querySelector("[data-hero]");
  const pizzaMotion = document.querySelector("[data-hero-pizza-motion]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frameId = null;

  function updatePizzaPosition() {
    frameId = null;

    if (!hero || !pizzaMotion || reducedMotion.matches) return;

    const { top, height } = hero.getBoundingClientRect();
    const progress = Math.min(Math.max(-top / (height * 0.8), 0), 1);
    const translateX = progress * 125;
    const translateY = progress * -4;
    const rotation = progress * 8;
    const scale = 1 - (progress * 0.04);

    pizzaMotion.style.transform = `translate3d(${translateX}%, ${translateY}%, 0) rotate(${rotation}deg) scale(${scale})`;
    pizzaMotion.style.opacity = String(1 - (progress * 0.25));
  }

  function requestPositionUpdate() {
    if (frameId !== null) return;

    frameId = requestAnimationFrame(updatePizzaPosition);
  }

  window.addEventListener("scroll", requestPositionUpdate, { passive: true });
  window.addEventListener("resize", requestPositionUpdate);
  reducedMotion.addEventListener("change", () => {
    if (reducedMotion.matches && pizzaMotion) {
      pizzaMotion.style.transform = "";
      pizzaMotion.style.opacity = "";
      return;
    }

    requestPositionUpdate();
  });

  requestPositionUpdate();
</script>
