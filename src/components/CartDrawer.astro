<aside
  id="cartDrawer"
  class="fixed left-0 top-0 z-[95] h-screen w-full max-w-md -translate-x-full overflow-y-auto bg-[var(--color-dark-soft)] shadow-2xl transition-transform duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cartDrawerTitle"
  aria-hidden="true"
  tabindex="-1"
>

  <div class="sticky top-0 flex items-center justify-between border-b border-white/10 bg-[var(--color-dark-soft)] p-6">

    <div>

      <h2
        id="cartDrawerTitle"
        class="text-2xl font-bold"
      >

        Mi Pedido

      </h2>

      <p class="text-sm text-gray-400">

        Food Express

      </p>

    </div>

    <button
      id="closeCart"
      class="rounded-xl bg-red-600 px-4 py-2 font-bold"
      type="button"
      aria-label="Cerrar carrito"
    >
      ✕
    </button>

  </div>

  <div
    id="cartItems"
    class="space-y-4 p-6"
  >

    <div class="rounded-2xl border border-dashed border-white/15 bg-white/[0.03] px-6 py-12 text-center">

      <span class="text-4xl" aria-hidden="true">🛒</span>

      <h3 class="mt-4 text-lg font-bold">

        Tu carrito está vacío

      </h3>

      <p class="mt-2 text-sm leading-6 text-gray-400">

        Agregá tus productos favoritos para comenzar tu pedido.

      </p>

    </div>

  </div>

  <div class="border-t border-white/10 p-6">

    <button
      id="clearCart"
      class="mb-5 hidden w-full rounded-xl border border-red-500/40 px-4 py-3 text-sm font-bold text-red-300 transition hover:bg-red-500/10"
      type="button"
    >

      Vaciar carrito

    </button>

    <div class="mb-5 flex items-center justify-between">

      <span class="text-lg">

        Total

      </span>

      <strong
        id="cartTotal"
        class="text-2xl text-yellow-400"
      >

        $0

      </strong>

    </div>

    <button
      id="sendWhatsapp"
      class="btn-primary w-full justify-center"
    >

      Enviar pedido

    </button>

  </div>

</aside>

<div
  id="cartOverlay"
  class="fixed inset-0 z-[94] hidden bg-black/70 backdrop-blur-sm"
></div>
