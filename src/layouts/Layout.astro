---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Food Express | Comida Rápida",
  description = "La mejor comida rápida de Miguel Lanús."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta
name="description"
content={description}
/>

<meta
name="theme-color"
content="#dc2626"
/>

<title>{title}</title>

</head>

<body class="bg-slate-50 text-slate-800 antialiased">

<slot />

</body>

</html>